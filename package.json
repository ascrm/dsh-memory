{
  "name": "@ascrm88/dsh-memory",
  "version": "0.1.1",
  "description": "Local-first, file-based two-tier memory plugin for DeepSeek Harness: auditable Markdown memories with verified trust, core injection and on-demand search",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "homepage": "https://github.com/ascrm/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/ascrm/dsh-memory/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "agent-memory",
    "memory",
    "local-first",
    "markdown",
    "sqlite",
    "fts5"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-memory": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/assets/sidebar-panel.png"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "prepare": "tsdown && node scripts/build-client.mjs",
    "test": "vitest run --pool=threads --no-file-parallelism --testTimeout=20000",
    "typecheck": "tsc --noEmit",
    "bench": "pnpm build && node scripts/perf-10k.mjs",
    "bench:sqlite": "pnpm build && node scripts/perf-10k.mjs sqlite",
    "bench:json": "pnpm build && node scripts/perf-10k.mjs json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascrm/dsh-memory.git"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
